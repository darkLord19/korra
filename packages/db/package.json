{
  "name": "@korra/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./browser": "./src/browser.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "db:bundle-migrations": "node scripts/gen-migrations.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@korra/core": "workspace:*",
    "@supabase/supabase-js": "2.117.2",
    "drizzle-orm": "~0.45.3",
    "postgres": "3.4.9",
    "server-only": "^0.0.1",
    "jszip": "3.10.2",
    "@electric-sql/pglite": "0.5.8"
  },
  "devDependencies": {
    "@korra/config": "workspace:*",
    "@types/node": "^22.20.5",
    "drizzle-kit": "~0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "fake-indexeddb": "^6.2.2"
  }
}
